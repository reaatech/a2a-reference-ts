{
  "name": "a2a-reference-ts",
  "version": "0.1.0",
  "private": true,
  "description": "Enterprise-grade TypeScript reference implementation of the A2A protocol with A2A↔MCP bridge",
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit -p tsconfig.typecheck.json",
    "docs": "typedoc",
    "docs:serve": "typedoc --watch",
    "clean": "turbo run clean && rm -rf node_modules",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish"
  },
  "keywords": [
    "a2a",
    "agent-to-agent",
    "mcp",
    "model-context-protocol",
    "agents",
    "ai",
    "protocol"
  ],
  "author": "Rick Somers <rick@reaatech.com> (https://reaatech.com)",
  "license": "MIT",
  "packageManager": "pnpm@10.22.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/reaatech/a2a-reference-ts.git"
  },
  "bugs": {
    "url": "https://github.com/reaatech/a2a-reference-ts/issues"
  },
  "homepage": "https://github.com/reaatech/a2a-reference-ts#readme",
  "pnpm": {
    "onlyBuiltDependencies": ["@biomejs/biome", "esbuild"],
    "overrides": {
      "fast-uri": "^3.1.2",
      "ip-address": "^10.1.1",
      "brace-expansion@>=5": ">=5.0.6",
      "@modelcontextprotocol/sdk>hono": "^4.12.18",
      "qs": "^6.15.2"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/changelog-github": "^0.6.0",
    "@changesets/cli": "^2.28.1",
    "@vitest/coverage-v8": "^4.1.0",
    "turbo": "^2.9.14",
    "typescript": "^5.8.3",
    "vitest": "^4.1.0"
  }
}
