# Runtime environment
NODE_ENV=development

# HTTP server port
PORT=3000

# Pino log level (trace, debug, info, warn, error, fatal)
LOG_LEVEL=info

# Redis URL for persistent task store (optional)
REDIS_URL=redis://localhost:6379

# JWKS URI for JWT authentication (optional)
JWKS_URI=https://auth.example.com/.well-known/jwks.json

# Comma-separated API keys for API key authentication (optional)
API_KEYS=secret-key-1,secret-key-2
